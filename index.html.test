              <span class="logo-rd-dark-bg text-3xl leading-none block">R&amp;D</span>
            </div>
            <div>
              <span class="font-display font-black text-lg tracking-tight block">RODRIGO CENTRO DIGITAL</span>
              <span class="text-xs text-brand-gold font-semibold uppercase tracking-wider">Tu estilo, nuestra impresión</span>
