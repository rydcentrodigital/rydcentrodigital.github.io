<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>R&D Rodrigo Centro Digital | Catálogo de Ropa y Personalización</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              black: '#111315',
              dark: '#1C1F24',
              gold: '#F4C414',
              goldHover: '#EAB308',
              gray: '#F4F5F7'
            }
          },
          fontFamily: {
            display: ['Montserrat', 'sans-serif'],
            sans: ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>
</head>
<body class="bg-white text-brand-black font-sans antialiased selection:bg-brand-gold selection:text-brand-black">

  <!-- 1. BARRA SUPERIOR DE ANUNCIOS -->
  <div class="bg-brand-black text-white text-xs sm:text-sm py-2.5 px-4 border-b border-brand-gold/30">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-1 text-center">
      <p class="font-medium tracking-wide">
        <span class="text-brand-gold font-bold">★</span> Personalización con <span class="text-brand-gold font-semibold">Bordado, Sublimación y Estampado</span> • Pedidos al por mayor y detalle
      </p>
      <div class="flex items-center gap-3 text-xs font-semibold">
        <a href="https://wa.me/18293135817" target="_blank" rel="noopener" class="hover:text-brand-gold transition flex items-center gap-1">
          <i class="fa-brands fa-whatsapp text-green-400"></i> 829-313-5817
        </a>
        <span class="text-gray-500">/</span>
        <a href="https://wa.me/18494393535" target="_blank" rel="noopener" class="hover:text-brand-gold transition flex items-center gap-1">
          <i class="fa-brands fa-whatsapp text-green-400"></i> 849-439-3535
        </a>
      </div>
    </div>
  </div>

  <!-- 2. HEADER / NAVEGACIÓN PRINCIPAL -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20 gap-4">
        <!-- Logo Oficial R&D Centro Digital -->
        <a href="#" onclick="resetFilters(); return false;" class="flex items-center gap-2.5 shrink-0 group">
          <div class="bg-brand-black px-3 py-1.5 rounded-xl border-2 border-brand-gold shadow-sm group-hover:scale-[1.02] transition">
            <span class="logo-rd-dark-bg text-2xl sm:text-3xl leading-none block">R&amp;D</span>
          </div>
          <div class="leading-tight">
            <span class="font-display font-black text-sm sm:text-base tracking-tight text-brand-black block">CENTRO DIGITAL</span>
            <span class="text-[11px] font-semibold text-amber-600 uppercase tracking-wider block">Tu estilo, nuestra impresión</span>
          </div>
        </a>

        <!-- Buscador en Tiempo Real (Desktop) -->
        <div class="hidden md:flex flex-1 max-w-md mx-4">
          <div class="relative w-full">
            <input 
              type="text" 
              id="searchInputDesktop"
              placeholder="Buscar modelo, tela o código (ej. ST-85, Dry Fit, Oxford, CH-001)..." 
              class="w-full pl-10 pr-9 py-2.5 bg-brand-gray border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-gold focus:bg-white transition"
            >
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <button id="clearSearchDesktop" onclick="clearSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-brand-black">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        </div>

        <!-- Botón de Lista de Cotización / Carrito -->
        <div class="flex items-center gap-2 sm:gap-3">
          <a href="#servicios" class="hidden lg:inline-flex text-sm font-semibold text-gray-700 hover:text-brand-black px-3 py-2 rounded-lg transition">
            Servicios
          </a>
          <button 
            onclick="toggleCartDrawer(true)" 
            class="relative inline-flex items-center gap-2.5 bg-brand-black hover:bg-brand-dark text-white font-semibold px-4 py-2.5 rounded-xl border border-brand-gold/40 shadow-sm transition active:scale-95"
          >
            <i class="fa-solid fa-clipboard-list text-brand-gold text-base"></i>
            <span class="text-sm hidden sm:inline">Mi Cotización</span>
            <span id="cartBadge" class="bg-brand-gold text-brand-black font-display font-extrabold text-xs px-2 py-0.5 rounded-full">0</span>
          </button>
        </div>
      </div>

      <!-- Buscador Móvil -->
      <div class="pb-3 md:hidden">
        <div class="relative w-full">
          <input 
            type="text" 
            id="searchInputMobile"
            placeholder="Buscar prenda, tela o código (ST-85, Oxford...)" 
            class="w-full pl-9 pr-8 py-2 bg-brand-gray border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-gold focus:bg-white"
          >
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
        </div>
      </div>

      <!-- Barra de Navegación por Categorías Exactas del Catálogo -->
      <nav aria-label="Categorías del catálogo" class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto no-scrollbar py-2.5 border-t border-gray-100">
        <button onclick="selectCategory('Todos')" data-cat="Todos" class="nav-cat-btn px-4 py-1.5 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition bg-brand-gold text-brand-black shadow-sm">
          Todos (34)
        </button>
        <button onclick="selectCategory('Gorras')" data-cat="Gorras" class="nav-cat-btn px-4 py-1.5 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition text-gray-600 hover:bg-brand-gray hover:text-brand-black">
          Gorras
        </button>
        <button onclick="selectCategory('Poloshirts')" data-cat="Poloshirts" class="nav-cat-btn px-4 py-1.5 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition text-gray-600 hover:bg-brand-gray hover:text-brand-black">
          Poloshirts
        </button>
        <button onclick="selectCategory('Camisetas')" data-cat="Camisetas" class="nav-cat-btn px-4 py-1.5 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition text-gray-600 hover:bg-brand-gray hover:text-brand-black">
          Camisetas
        </button>
        <button onclick="selectCategory('Camisas')" data-cat="Camisas" class="nav-cat-btn px-4 py-1.5 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition text-gray-600 hover:bg-brand-gray hover:text-brand-black">
          Camisas
        </button>
        <button onclick="selectCategory('Abrigos')" data-cat="Abrigos" class="nav-cat-btn px-4 py-1.5 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition text-gray-600 hover:bg-brand-gray hover:text-brand-black">
          Abrigos
        </button>
        <button onclick="selectCategory('Chalecos')" data-cat="Chalecos" class="nav-cat-btn px-4 py-1.5 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition text-gray-600 hover:bg-brand-gray hover:text-brand-black">
          Chalecos
        </button>
      </nav>
    </div>
  </header>

  <!-- 3. HERO BANNER PRINCIPAL -->
  <section class="relative bg-brand-black text-white overflow-hidden">
    <!-- Patrón geométrico sutil -->
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#F4C414 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="absolute -right-24 -top-24 w-96 h-96 bg-brand-gold/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Columna Texto -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 bg-white/10 border border-brand-gold/40 rounded-full px-4 py-1.5 text-xs sm:text-sm font-semibold text-brand-gold">
            <i class="fa-solid fa-needle"></i>
            <span>Catálogo Oficial • Uniformes Empresariales, Escolares y Promocionales</span>
          </div>

          <h1 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.08] uppercase">
            CATÁLOGO DE ROPA Y <span class="text-brand-gold">PERSONALIZACIÓN</span>
          </h1>

          <p class="text-gray-300 text-base sm:text-lg max-w-2xl leading-relaxed">
            <strong class="text-white">Tu estilo, nuestra impresión.</strong> Explora nuestra colección completa de gorras, poloshirts, camisetas, camisas tipo Columbia y Oxford, abrigos y chalecos de seguridad listos para <span class="text-brand-gold font-semibold">bordado computarizado, sublimación y estampado</span>.
          </p>

          <div class="flex flex-wrap items-center gap-3.5 pt-2">
            <a href="#catalogo" class="inline-flex items-center justify-center gap-2 bg-brand-gold hover:bg-brand-goldHover text-brand-black font-display font-extrabold text-sm sm:text-base px-6 py-3.5 rounded-xl shadow-lg shadow-brand-gold/20 transition transform hover:-translate-y-0.5">
              <span>Explorar Catálogo</span>
              <i class="fa-solid fa-arrow-down"></i>
            </a>
            <a href="https://wa.me/18293135817?text=Hola%20R%26D%20Rodrigo%20Centro%20Digital,%20me%20gustar%C3%ADa%20solicitar%20una%20cotizaci%C3%B3n%20de%20ropa%20personalizada." target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/25 font-semibold text-sm sm:text-base px-6 py-3.5 rounded-xl transition">
              <i class="fa-brands fa-whatsapp text-green-400 text-lg"></i>
              <span>Cotizar por WhatsApp</span>
            </a>
          </div>

          <!-- Indicadores de confianza -->
          <div class="grid grid-cols-3 gap-4 pt-4 border-t border-white/10 max-w-lg">
            <div>
              <span class="font-display font-black text-xl sm:text-2xl text-brand-gold block">6 Líneas</span>
              <span class="text-xs text-gray-400">De prendas textiles</span>
            </div>
            <div>
              <span class="font-display font-black text-xl sm:text-2xl text-brand-gold block">+28 Colores</span>
              <span class="text-xs text-gray-400">Disponibles en stock</span>
            </div>
            <div>
              <span class="font-display font-black text-xl sm:text-2xl text-brand-gold block">2 a XXL</span>
              <span class="text-xs text-gray-400">Tallas niños y adultos</span>
            </div>
          </div>
        </div>

        <!-- Columna Accesos Rápidos por Categoría -->
        <div class="lg:col-span-5">
          <div class="bg-brand-dark/90 border border-white/10 rounded-2xl p-5 sm:p-6 shadow-2xl">
            <div class="flex items-center justify-between mb-4">
              <h2 class="font-display font-extrabold text-sm uppercase tracking-wider text-brand-gold">Acceso Directo por Línea</h2>
              <span class="text-xs text-gray-400">Selecciona una categoría</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <button onclick="jumpToCategory('Gorras')" class="group bg-brand-black hover:bg-brand-gold hover:text-brand-black border border-white/10 hover:border-brand-gold rounded-xl p-3.5 text-left transition flex flex-col justify-between h-24">
                <span class="text-brand-gold group-hover:text-brand-black text-lg"><i class="fa-solid fa-hat-cowboy-side"></i></span>
                <div>
                  <span class="font-display font-extrabold text-xs uppercase block">Gorras</span>
                  <span class="text-[11px] opacity-75">10 estilos</span>
                </div>
              </button>

              <button onclick="jumpToCategory('Poloshirts')" class="group bg-brand-black hover:bg-brand-gold hover:text-brand-black border border-white/10 hover:border-brand-gold rounded-xl p-3.5 text-left transition flex flex-col justify-between h-24">
                <span class="text-brand-gold group-hover:text-brand-black text-lg"><i class="fa-solid fa-shirt"></i></span>
                <div>
                  <span class="font-display font-extrabold text-xs uppercase block">Poloshirts</span>
                  <span class="text-[11px] opacity-75">7 modelos</span>
                </div>
              </button>

              <button onclick="jumpToCategory('Camisetas')" class="group bg-brand-black hover:bg-brand-gold hover:text-brand-black border border-white/10 hover:border-brand-gold rounded-xl p-3.5 text-left transition flex flex-col justify-between h-24">
                <span class="text-brand-gold group-hover:text-brand-black text-lg"><i class="fa-solid fa-tshirt"></i></span>
                <div>
                  <span class="font-display font-extrabold text-xs uppercase block">Camisetas</span>
                  <span class="text-[11px] opacity-75">9 estilos</span>
                </div>
              </button>

              <button onclick="jumpToCategory('Camisas')" class="group bg-brand-black hover:bg-brand-gold hover:text-brand-black border border-white/10 hover:border-brand-gold rounded-xl p-3.5 text-left transition flex flex-col justify-between h-24">
                <span class="text-brand-gold group-hover:text-brand-black text-lg"><i class="fa-solid fa-user-tie"></i></span>
                <div>
                  <span class="font-display font-extrabold text-xs uppercase block">Camisas</span>
                  <span class="text-[11px] opacity-75">Columbia &amp; Oxford</span>
                </div>
              </button>

              <button onclick="jumpToCategory('Abrigos')" class="group bg-brand-black hover:bg-brand-gold hover:text-brand-black border border-white/10 hover:border-brand-gold rounded-xl p-3.5 text-left transition flex flex-col justify-between h-24">
                <span class="text-brand-gold group-hover:text-brand-black text-lg"><i class="fa-solid fa-vest-patches"></i></span>
                <div>
                  <span class="font-display font-extrabold text-xs uppercase block">Abrigos</span>
                  <span class="text-[11px] opacity-75">Hoodies &amp; Escolar</span>
                </div>
              </button>

              <button onclick="jumpToCategory('Chalecos')" class="group bg-brand-black hover:bg-brand-gold hover:text-brand-black border border-white/10 hover:border-brand-gold rounded-xl p-3.5 text-left transition flex flex-col justify-between h-24">
                <span class="text-brand-gold group-hover:text-brand-black text-lg"><i class="fa-solid fa-shield-halved"></i></span>
                <div>
                  <span class="font-display font-extrabold text-xs uppercase block">Chalecos</span>
                  <span class="text-[11px] opacity-75">Reflectivos 360°</span>
                </div>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SECCIÓN DE CATÁLOGO INTERACTIVO CON FILTROS -->
  <main id="catalogo" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Encabezado y Controles de Filtro -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-600">Catálogo Digital Interactivo</span>
        <h2 class="font-display font-black text-2xl sm:text-3xl text-brand-black uppercase mt-1">
          Selecciona tu Prenda y Color
        </h2>
        <p class="text-sm text-gray-600 mt-1">Haz clic en los círculos de color para previsualizar el tono en cada prenda o abre el personalizador.</p>
      </div>
      <div class="text-sm font-semibold text-gray-700 bg-brand-gray px-4 py-2 rounded-xl border border-gray-200 self-start md:self-auto">
        Mostrando <span id="productCount" class="font-display font-extrabold text-brand-black">34</span> productos
      </div>
    </div>

    <!-- Pestañas de Categoría + Filtro Secundario por Tela / Uso -->
    <div class="bg-brand-gray p-4 rounded-2xl border border-gray-200 mb-8 space-y-4">
      <!-- Fila 1: Categorías -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold uppercase text-gray-500 mr-1">Categoría:</span>
        <button onclick="selectCategory('Todos')" data-tab="Todos" class="tab-cat-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-brand-black text-brand-gold transition">Todas</button>
        <button onclick="selectCategory('Gorras')" data-tab="Gorras" class="tab-cat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Gorras</button>
        <button onclick="selectCategory('Poloshirts')" data-tab="Poloshirts" class="tab-cat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Poloshirts</button>
        <button onclick="selectCategory('Camisetas')" data-tab="Camisetas" class="tab-cat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Camisetas</button>
        <button onclick="selectCategory('Camisas')" data-tab="Camisas" class="tab-cat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Camisas</button>
        <button onclick="selectCategory('Abrigos')" data-tab="Abrigos" class="tab-cat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Abrigos</button>
        <button onclick="selectCategory('Chalecos')" data-tab="Chalecos" class="tab-cat-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Chalecos</button>
      </div>

      <!-- Fila 2: Filtro Secundario por Tela / Uso -->
      <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-gray-200/80">
        <span class="text-xs font-bold uppercase text-gray-500 mr-1">Tela / Uso:</span>
        <button onclick="selectFabric('Todos')" data-fab="Todos" class="fab-btn px-3 py-1 rounded-lg text-xs font-bold bg-brand-gold text-brand-black transition">Todos</button>
        <button onclick="selectFabric('Microfibra')" data-fab="Microfibra" class="fab-btn px-3 py-1 rounded-lg text-xs font-medium bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Microfibra</button>
        <button onclick="selectFabric('Dry Fit')" data-fab="Dry Fit" class="fab-btn px-3 py-1 rounded-lg text-xs font-medium bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Dry Fit</button>
        <button onclick="selectFabric('100% Algodón')" data-fab="100% Algodón" class="fab-btn px-3 py-1 rounded-lg text-xs font-medium bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">100% Algodón</button>
        <button onclick="selectFabric('Oxford')" data-fab="Oxford" class="fab-btn px-3 py-1 rounded-lg text-xs font-medium bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Oxford</button>
        <button onclick="selectFabric('Tipo Columbia')" data-fab="Tipo Columbia" class="fab-btn px-3 py-1 rounded-lg text-xs font-medium bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Tipo Columbia</button>
        <button onclick="selectFabric('Escolar')" data-fab="Escolar" class="fab-btn px-3 py-1 rounded-lg text-xs font-medium bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Escolar</button>
        <button onclick="selectFabric('Seguridad')" data-fab="Seguridad" class="fab-btn px-3 py-1 rounded-lg text-xs font-medium bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 transition">Seguridad</button>
      </div>
    </div>

    <!-- Cuadrícula de Productos -->
    <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <!-- Se renderiza dinámicamente mediante JavaScript -->
    </div>

    <!-- Estado Vacío si no hay resultados -->
    <div id="emptyState" class="hidden text-center py-16 bg-brand-gray rounded-2xl border border-gray-200">
      <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm text-brand-gold text-2xl">
        <i class="fa-solid fa-magnifying-glass"></i>
      </div>
      <h3 class="font-display font-bold text-lg text-brand-black">No encontramos prendas con ese filtro</h3>
      <p class="text-sm text-gray-600 mt-1 mb-5">Intenta limpiar tu búsqueda o seleccionar otra categoría del catálogo.</p>
      <button onclick="resetFilters()" class="bg-brand-black text-brand-gold font-bold text-sm px-5 py-2.5 rounded-xl hover:bg-brand-dark transition">
        Restablecer Filtros
      </button>
    </div>
  </main>

  <!-- 7. SECCIÓN DE SERVICIOS Y VALORES DE MARCA (Última página del catálogo) -->
  <section id="servicios" class="bg-brand-gray border-t border-gray-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-600">¿Por qué elegirnos?</span>
        <h2 class="font-display font-black text-2xl sm:text-4xl text-brand-black uppercase mt-1">
          Compromiso R&amp;D Centro Digital
        </h2>
        <p class="text-sm sm:text-base text-gray-600 mt-2">
          Seguimos creando juntos tu estilo, con la mejor calidad y personalización para tu marca, institución o evento.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:border-brand-gold transition">
          <div class="w-12 h-12 bg-brand-black text-brand-gold rounded-xl flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-shirt"></i>
          </div>
          <h3 class="font-display font-extrabold text-base uppercase text-brand-black">Ropa Personalizada</h3>
          <p class="text-sm text-gray-600 mt-2 leading-relaxed">
            Bordado computarizado de alta densidad, sublimación full color y estampado DTF/serigrafía sobre cada prenda del catálogo.
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:border-brand-gold transition">
          <div class="w-12 h-12 bg-brand-black text-brand-gold rounded-xl flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-award"></i>
          </div>
          <h3 class="font-display font-extrabold text-base uppercase text-brand-black">Calidad en Cada Detalle</h3>
          <p class="text-sm text-gray-600 mt-2 leading-relaxed">
            Telas seleccionadas (Microfibra, Waffle Dry, Piqué, Bulldenim, Oxford y 100% Algodón) con costuras reforzadas y colores duraderos.
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:border-brand-gold transition">
          <div class="w-12 h-12 bg-brand-black text-brand-gold rounded-xl flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-headset"></i>
          </div>
          <h3 class="font-display font-extrabold text-base uppercase text-brand-black">Atención Personalizada</h3>
          <p class="text-sm text-gray-600 mt-2 leading-relaxed">
            Asesoría directa en selección de tallas, combinación de colores y montaje digital de tu logotipo antes de producir.
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:border-brand-gold transition">
          <div class="w-12 h-12 bg-brand-black text-brand-gold rounded-xl flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-handshake"></i>
          </div>
          <h3 class="font-display font-extrabold text-base uppercase text-brand-black">Tu Confianza Nos Impulsa</h3>
          <p class="text-sm text-gray-600 mt-2 leading-relaxed">
            Entregas puntuales para empresas, colegios, equipos deportivos, eventos promocionales y pedidos individuales.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FOOTER COMPLETO CON DATOS REALES DEL CATÁLOGO -->
  <footer class="bg-brand-black text-white border-t-4 border-brand-gold">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <!-- Marca -->
        <div class="space-y-4">
          <div class="inline-flex items-center gap-3">
