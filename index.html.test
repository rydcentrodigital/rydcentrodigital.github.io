            <li><button onclick="jumpToCategory('Abrigos')" class="hover:text-brand-gold transition">• Abrigos &amp; Hoodies</button></li>
            <li><button onclick="jumpToCategory('Chalecos')" class="hover:text-brand-gold transition">• Chalecos Reflectivos</button></li>
          </ul>
        </div>

        <!-- Contacto Directo Oficial -->
        <div>
          <h4 class="font-display font-extrabold text-sm uppercase tracking-wider text-brand-gold mb-4">Contacto y Redes Oficiales</h4>
