  <!-- 5. MODAL DE DETALLE Y PERSONALIZACIÓN DE PRENDA -->
  <div id="productModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/70 backdrop-blur-sm p-3 sm:p-6 flex items-center justify-center">
    <div class="bg-white w-full max-w-4xl rounded-2xl shadow-2xl border border-gray-200 overflow-hidden my-auto animate-fadeIn">
      <!-- Header Modal -->
      <div class="flex items-center justify-between px-6 py-4 bg-brand-black text-white border-b border-brand-gold/30">
        <div class="flex items-center gap-2.5">
          <span id="modalCategoryBadge" class="bg-brand-gold text-brand-black font-display font-extrabold text-xs uppercase px-2.5 py-1 rounded-lg">Categoría</span>
          <span id="modalCodeBadge" class="text-xs font-mono text-gray-300">REF</span>
        </div>
        <button onclick="closeProductModal()" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Cuerpo Modal -->
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <!-- Vista Previa Interactiva SVG + Simulación de Bordado/Estampado -->
        <div class="lg:col-span-6 bg-brand-gray p-6 sm:p-8 flex flex-col items-center justify-between border-b lg:border-b-0 lg:border-r border-gray-200">
          <div class="w-full flex items-center justify-between text-xs text-gray-500 mb-2">
            <span class="font-semibold"><i class="fa-solid fa-eye text-amber-600 mr-1"></i> Vista Previa en Vivo</span>
            <span id="modalSelectedColorLabel" class="font-bold text-brand-black bg-white px-2.5 py-1 rounded-lg border border-gray-200">Negro</span>
          </div>

          <!-- Lienzo SVG Grande -->
          <div id="modalSvgContainer" class="w-full max-w-[290px] h-[270px] flex items-center justify-center my-2">
            <!-- SVG inyectado dinámicamente -->
          </div>

          <!-- Selector de Ubicación de Bordado / Estampado -->
          <div class="w-full bg-white p-3.5 rounded-xl border border-gray-200 mt-2">
            <span class="text-[11px] font-bold uppercase text-gray-500 block mb-2">Simular Ubicación de Logo / Arte:</span>
            <div id="placementButtons" class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
              <!-- Botones generados según tipo de prenda -->
            </div>
          </div>
        </div>

        <!-- Controles de Configuración -->
        <div class="lg:col-span-6 p-6 sm:p-7 space-y-5 max-h-[82vh] overflow-y-auto">
          <div>
            <h3 id="modalTitle" class="font-display font-black text-xl sm:text-2xl text-brand-black uppercase leading-tight">Título del Producto</h3>
            <p id="modalDesc" class="text-sm text-gray-600 mt-1.5 leading-relaxed">Descripción técnica de la tela y confección.</p>
          </div>

          <!-- 1. Selector de Color -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-xs font-bold uppercase text-gray-700">1. Color Disponible:</label>
              <span id="modalColorCount" class="text-xs text-gray-500"></span>
            </div>
            <div id="modalSwatches" class="flex flex-wrap gap-2 max-h-28 overflow-y-auto p-1">
              <!-- Muestras de color dinámicas -->
            </div>
          </div>

          <!-- 2. Selector de Tallas Reales del Catálogo -->
          <div>
            <label class="text-xs font-bold uppercase text-gray-700 block mb-2">2. Talla / Ajuste:</label>
            <div id="modalSizes" class="flex flex-wrap gap-2">
              <!-- Tallas dinámicas -->
            </div>
          </div>

          <!-- 3. Tipo de Personalización -->
          <div>
            <label class="text-xs font-bold uppercase text-gray-700 block mb-2">3. Tipo de Personalización Deseada:</label>
            <div class="grid grid-cols-2 gap-2" id="customTypeGrid">
              <button type="button" onclick="selectCustomType('Bordado Computarizado')" data-ctype="Bordado Computarizado" class="ctype-btn text-left p-2.5 rounded-xl border-2 border-brand-black bg-brand-gold/15 text-xs font-bold text-brand-black transition">
                <i class="fa-solid fa-needle text-amber-600 mr-1"></i> Bordado Computarizado
              </button>
              <button type="button" onclick="selectCustomType('Sublimación')" data-ctype="Sublimación" class="ctype-btn text-left p-2.5 rounded-xl border border-gray-200 hover:border-gray-400 text-xs font-semibold text-gray-700 transition">
                <i class="fa-solid fa-fill-drip text-blue-600 mr-1"></i> Sublimación
              </button>
              <button type="button" onclick="selectCustomType('Serigrafía / DTF')" data-ctype="Serigrafía / DTF" class="ctype-btn text-left p-2.5 rounded-xl border border-gray-200 hover:border-gray-400 text-xs font-semibold text-gray-700 transition">
                <i class="fa-solid fa-print text-purple-600 mr-1"></i> Serigrafía / DTF
              </button>
              <button type="button" onclick="selectCustomType('Prenda Lisa (Sin personalizar)')" data-ctype="Prenda Lisa (Sin personalizar)" class="ctype-btn text-left p-2.5 rounded-xl border border-gray-200 hover:border-gray-400 text-xs font-semibold text-gray-700 transition">
                <i class="fa-solid fa-shirt text-gray-500 mr-1"></i> Prenda Lisa
              </button>
            </div>
          </div>

          <!-- 4. Cantidad y Botón Agregar -->
          <div class="pt-3 border-t border-gray-200 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="flex items-center justify-between sm:justify-start bg-brand-gray border border-gray-200 rounded-xl px-3 py-2">
              <span class="text-xs font-bold text-gray-600 mr-3">Cantidad:</span>
              <div class="flex items-center gap-2">
                <button type="button" onclick="changeModalQty(-1)" class="w-8 h-8 rounded-lg bg-white border border-gray-300 font-bold hover:bg-gray-100">-</button>
                <input type="number" id="modalQtyInput" value="12" min="1" max="5000" class="w-14 text-center font-display font-bold text-sm bg-transparent focus:outline-none">
                <button type="button" onclick="changeModalQty(1)" class="w-8 h-8 rounded-lg bg-white border border-gray-300 font-bold hover:bg-gray-100">+</button>
              </div>
            </div>

            <button type="button" onclick="addCurrentModalToCart()" class="flex-1 bg-brand-gold hover:bg-brand-goldHover text-brand-black font-display font-extrabold text-sm py-3.5 px-5 rounded-xl shadow-md transition flex items-center justify-center gap-2 active:scale-95">
              <i class="fa-solid fa-plus-circle"></i>
              <span>Agregar a mi Cotización</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. CAJÓN LATERAL (DRAWER) DE CARRITO / COTIZADOR WHATSAPP -->
  <div id="cartDrawerBackdrop" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs transition-opacity" onclick="toggleCartDrawer(false)"></div>
  <aside id="cartDrawer" class="fixed top-0 right-0 z-50 h-full w-full max-w-md bg-white shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col">
    <!-- Header Drawer -->
    <div class="bg-brand-black text-white px-6 py-4 flex items-center justify-between border-b border-brand-gold/40">
      <div class="flex items-center gap-2.5">
        <i class="fa-solid fa-clipboard-check text-brand-gold text-xl"></i>
        <div>
          <h3 class="font-display font-extrabold text-base uppercase">Lista de Cotización</h3>
          <p class="text-[11px] text-gray-400">R&amp;D Rodrigo Centro Digital</p>
        </div>
      </div>
      <button onclick="toggleCartDrawer(false)" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-white">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Lista de Artículos -->
    <div id="cartItemsContainer" class="flex-1 overflow-y-auto p-5 space-y-3 bg-brand-gray/50">
      <!-- Items dinámicos -->
    </div>

    <!-- Footer Drawer con Formulario de Envío a WhatsApp -->
    <div class="p-5 bg-white border-t border-gray-200 space-y-3">
      <div class="flex items-center justify-between text-sm">
        <span class="font-semibold text-gray-600">Total de prendas a cotizar:</span>
        <span id="cartTotalUnits" class="font-display font-black text-lg text-brand-black">0 unidades</span>
      </div>

      <div>
        <label for="clientNameInput" class="block text-xs font-bold uppercase text-gray-700 mb-1">Tu Nombre o Empresa:</label>
        <input type="text" id="clientNameInput" placeholder="Ej. Juan Pérez / Inversiones Caribe SRL" class="w-full px-3.5 py-2.5 bg-brand-gray border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-gold focus:bg-white">
      </div>

      <div class="grid grid-cols-1 gap-2 pt-1">
        <button onclick="sendWhatsAppQuote('18293135817')" class="w-full bg-green-600 hover:bg-green-700 text-white font-display font-extrabold text-xs sm:text-sm py-3 px-4 rounded-xl shadow-md transition flex items-center justify-center gap-2">
          <i class="fa-brands fa-whatsapp text-lg"></i>
          <span>Enviar Cotización (829-313-5817)</span>
        </button>
        <button onclick="sendWhatsAppQuote('18494393535')" class="w-full bg-brand-black hover:bg-brand-dark text-brand-gold border border-brand-gold/50 font-display font-bold text-xs py-2.5 px-4 rounded-xl transition flex items-center justify-center gap-2">
          <i class="fa-brands fa-whatsapp text-green-400 text-base"></i>
          <span>Línea Alterna Ventas (849-439-3535)</span>
        </button>
      </div>
    </div>
  </aside>

  <!-- Toast de Notificación (Reemplazo elegante de alert()) -->
  <div id="toastNotification" class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 hidden bg-brand-black text-white px-5 py-3 rounded-xl shadow-2xl border border-brand-gold flex items-center gap-3 text-sm font-semibold">
    <i class="fa-solid fa-circle-check text-brand-gold text-base"></i>
    <span id="toastMessage">Prenda agregada a tu cotización</span>
  </div>
</body>
</html>